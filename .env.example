# ---------------------------------------------------------------------------
# AJ Social Insights — environment variables
# Copy to `.env` and adjust. Every variable the apps read is listed here.
# ---------------------------------------------------------------------------

# --- Docker Compose host ports ---------------------------------------------
# Host ports for the services started by `make up` (container ports are fixed).
POSTGRES_PORT=5440
POSTGRES_TEST_PORT=5441
API_PORT=8000
WEB_PORT=3000

# --- Database --------------------------------------------------------------
POSTGRES_USER=social_insights
POSTGRES_PASSWORD=social_insights
# Async SQLAlchemy URL used by the backend (local runs; compose overrides the host).
DATABASE_URL=postgresql+asyncpg://social_insights:social_insights@localhost:5440/social_insights
# Database used by integration tests (the `postgres-test` service).
TEST_DATABASE_URL=postgresql+asyncpg://social_insights:social_insights@localhost:5441/social_insights_test

# --- Backend ---------------------------------------------------------------
# local | test | production
ENVIRONMENT=local
LOG_LEVEL=INFO
# Where posts come from: seed (sample data) | meta (Meta Graph API, not built yet)
DATA_SOURCE=seed

# --- LLM (tagging + recommendations) ---------------------------------------
# Configure Anthropic, Azure OpenAI, or both. With both, LLM_PROVIDER is tried first and
# the other is used automatically if it fails (e.g. a spending limit or outage).
# With neither, tagging uses rule-based tags and recommendations use templates.
LLM_PROVIDER=anthropic           # anthropic | azure_openai

ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

AZURE_OPENAI_ENDPOINT=           # e.g. https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=         # the deployment name you created in Azure AI Foundry
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# true for reasoning models (gpt-5, o-series); set false for gpt-4o / gpt-4.1 deployments.
AZURE_OPENAI_REASONING=true

# --- Frontend --------------------------------------------------------------
# Backend base URL, used server-side only (never exposed to the browser).
API_URL=http://localhost:8000
